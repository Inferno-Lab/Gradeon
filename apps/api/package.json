{
  "name": "@gradeon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@gradeon/config-engine": "workspace:*",
    "@gradeon/contracts": "workspace:*",
    "@gradeon/db": "workspace:*",
    "@gradeon/integrations": "workspace:*",
    "@gradeon/nest-kit": "workspace:*",
    "@gradeon/security": "workspace:*",
    "@gradeon/tenancy": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@pdf-lib/fontkit": "1.1.1",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.12.5",
    "pdf-lib": "1.17.1",
    "reflect-metadata": "^0.2.2",
    "regenerator-runtime": "0.14.1",
    "rxjs": "^7.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  }
}